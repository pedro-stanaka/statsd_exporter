FROM golang:1.19-alpine as builder

COPY go.mod go.sum /go/github.com/Shopify/statsd-exporter/

WORKDIR /go/github.com/Shopify/statsd-exporter/

RUN go mod download

RUN apk add --no-cache git make curl

COPY . .

RUN make build


FROM gcr.io/shopify-base-images/alpine:latest
COPY --from=builder /go/github.com/Shopify/statsd-exporter/statsd-exporter /usr/bin/statsd_exporter

USER nobody
EXPOSE      9102 9125 9125/udp
ENTRYPOINT  [ "/usr/bin/statsd_exporter" ]
